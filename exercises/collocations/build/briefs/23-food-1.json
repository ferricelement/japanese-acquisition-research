    "english": "I'm driving today, so I can't drink."
   },
   "examplePolite": {
    "romaji": "kyou wa kuruma na node, osake wa nomenai n desu.",
    "ja": "今日は車なので、お酒は飲めないんです。",
    "english": "I'm driving today, so I can't drink."
   }
  },
