  },
  {
   "id": "c-me-ga-sameru",
   "romaji": "me ga sameru",
   "polite": "me ga samemasu",
   "english": "wake up (from sleep); feel wide awake (me ga sameta)",
   "ja": "目が覚める",
   "kana": "めがさめる",
   "politeJa": "目が覚めます",
   "noun": "me",
   "particle": "ga",
   "verb": "sameru",
   "verbJa": "覚める",
   "verbSense": "wake, come out of sleep or a daze",
   "englishVerb": "wake up",
   "trap": "English 'wake up' covers two things. okiru is waking or getting up (yonaka ni okichatta is fine), but me ga sameru is only the waking and never getting out of bed: yoji ni me ga sameta kedo, okita no wa shichiji.",
   "partners": [
    "yoi (drunkenness)"
   ],
   "flags": [],
   "use": "For the moment of waking, often unplanned: yonaka ni me ga sameta (I woke in the night). It also means feeling wide awake, e.g. after coffee. Getting out of bed is okiru.",
   "notes": "Not the sameru of gohan ga sameru (food gets cold). mezamashi (alarm) comes from the transitive me o samasu (wake up, wake someone).",
