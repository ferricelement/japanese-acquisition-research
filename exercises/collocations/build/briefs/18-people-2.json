 "label": "Making friends",
 "topic": "People & talk",
 "rationale": "Meeting someone new: making friends, becoming friends with one person, swapping names, going up to someone, and chances to meet people.",
 "mixUps": "tomodachi ga dekiru is gaining friends in general (tomodachi dekita), while one person is X to tomodachi ni naru; neither is tomodachi o tsukuru. 'Tell me your name' is namae oshiete, not iu, and going up to someone is koe o kakeru, not hanasu.",
 "targets": [
  {
   "id": "c-tomodachi-ga-dekiru",
   "romaji": "tomodachi ga dekiru",
   "polite": "tomodachi ga dekimasu",
   "english": "make a friend, make friends",
   "ja": "友達ができる",
   "kana": "ともだちができる",
   "politeJa": "友達ができます",
   "noun": "tomodachi",
   "particle": "ga",
   "verb": "dekiru",
   "verbJa": "できる",
   "verbSense": "come into being, be made; also 'can do' and 'be ready'",
   "englishVerb": "make",
   "trap": "English 'make' leads to tomodachi o tsukuru, which natives use for setting out to make friends (tomodachi tsukuritai); 'I've made a friend' is tomodachi dekita.",
   "partners": [
    "kareshi (boyfriend)",
    "kanojo (girlfriend)",
    "koibito (partner)",
    "kodomo (child: kodomo dekita = we're expecting; akachan works too)"
   ],
   "flags": [],
   "use": "Said once a friendship has formed, so mostly in the past: tomodachi dekita (I've made a friend). kareshi / kanojo dekita (got a boyfriend / girlfriend) works the same way.",
   "notes": "Wanting friends is usually tomodachi hoshii or tomodachi tsukuritai. Having them takes ga iru, as in kodomo ga iru: dekita is the moment it happens, iru is having them (tomodachi iru?). Becoming friends with one person is X to tomodachi ni naru.",
   "example": {
    "romaji": "kotchi de mou tomodachi dekita?",
    "ja": "こっちでもう友達できた？",
    "english": "Made any friends here yet?"
   },
   "examplePolite": {
    "romaji": "kochira de tomodachi wa dekimashita ka?",
    "ja": "こちらで友達はできましたか？",
    "english": "Have you made any friends here?"
   }
  },
  {
   "id": "c-tomodachi-ni-naru",
   "romaji": "tomodachi ni naru",
   "polite": "tomodachi ni narimasu",
   "english": "become friends (with someone)",
   "ja": "友達になる",
   "kana": "ともだちになる",
   "politeJa": "友達になります",
   "noun": "tomodachi",
   "particle": "ni",
   "verb": "naru",
   "verbJa": "なる",
   "verbSense": "become (with ni after a noun)",
   "englishVerb": "make",
   "trap": "English 'make friends with him' leads to tomodachi o tsukuru, which is setting out to make friends in general (tomodachi tsukuritai). With a particular person it's kare to tomodachi ni natta, and 'I've made a friend' is tomodachi dekita.",
   "partners": [
    "nakama (mates, teammates)",
    "kazoku (family: by marriage or adoption)",
    "koibito (a couple; tsukiau is the usual 'start going out')"
   ],
   "flags": [],
   "use": "Takes to for the other person: kare to tomodachi ni natta (I became friends with him). Mostly told in the past, about where or how a friendship started.",
   "notes": "nakayoku naru (get close) is the near twin: sugu nakayoku natta (we hit it off right away). tomodachi ni narou = let's be friends.",
   "example": {
    "romaji": "kanojo to wa daigaku de tomodachi ni natta.",
    "ja": "彼女とは大学で友達になった。",
    "english": "She and I became friends at uni."
   },
   "examplePolite": {
    "romaji": "kanojo to wa daigaku de tomodachi ni narimashita.",
    "ja": "彼女とは大学で友達になりました。",
    "english": "She and I became friends at university."
   }
  },
  {
   "id": "c-namae-o-oshieru",
   "romaji": "namae o oshieru",
   "polite": "namae o oshiemasu",
   "english": "tell someone your name",
   "ja": "名前を教える",
   "kana": "なまえをおしえる",
   "politeJa": "名前を教えます",
   "noun": "namae",
   "particle": "o",
   "verb": "oshieru",
   "verbJa": "教える",
   "verbSense": "teach; also tell, let someone know (information)",
   "englishVerb": "tell",
   "trap": "English 'tell me your name' leads to iu, and namae o iu is real Japanese: it's saying a name out loud (in a roll call, or saying your own). Asking someone to share their name, number or the way takes oshieru: namae oshiete.",
   "partners": [
    "bangou (phone number)",
    "renrakusaki (contact details)",
    "michi (the way: michi o oshieru = give directions)"
   ],
   "flags": [],
   "use": "Mostly the request namae oshiete (what's your name?), a friendly alternative to onamae wa? or namae nante iu no?. The same oshieru asks for any personal details: bangou oshiete (give me your number).",
   "notes": "onamae wa? is the plain polite question (at a counter, or to a child); between friends namae nante iu no? is common.",
   "example": {
    "romaji": "yokattara, namae oshiete kureru?",
    "ja": "よかったら、名前教えてくれる？",
    "english": "If you don't mind, what's your name?"
   },
   "examplePolite": {
    "romaji": "yokattara, onamae o oshiete moraemasu ka?",
    "ja": "よかったら、お名前を教えてもらえますか？",
    "english": "Would you mind telling me your name?"
   }
  },
  {
   "id": "c-koe-o-kakeru",
   "romaji": "koe o kakeru",
   "polite": "koe o kakemasu",
   "english": "speak to, call out to; ask along",
   "ja": "声をかける",
   "kana": "こえをかける",
   "politeJa": "声をかけます",
   "noun": "koe",
   "particle": "o",
   "verb": "kakeru",
   "verbJa": "かける",
   "verbSense": "hang or put something onto something; here, direct your voice at someone",
   "englishVerb": "talk",
   "trap": "'Talk to someone' leads to hanasu, which is fine once you're talking: X to hanasu is chatting with X, X ni hanasu is telling X something. Going up to someone, calling them over or giving them a shout is koe o kakeru (hanashikakeru also works for starting a chat).",
   "partners": [
    "kotoba (words: yasashii kotoba o kakeru = say something kind to someone)"
   ],
   "flags": [],
   "use": "Used for going up to someone, or asking to be told: nanka attara koe kakete (give me a shout if anything comes up). Also the everyday way to invite someone along: tanaka-san ni mo koe kakeyou ka? (shall we ask Tanaka too?). koe kakerareta can mean someone came up to you, including being hit on.",
   "notes": "hanashikakeru (start talking to someone) is the close single verb. Same kakeru as denwa o kakeru (make a call) and meiwaku o kakeru, in a different sense.",
   "example": {
    "romaji": "nanka attara koe kakete ne.",
    "ja": "なんかあったら声かけてね。",
    "english": "Give me a shout if you need anything."
   },
   "examplePolite": {
    "romaji": "nanika attara koe o kakete kudasai ne.",
    "ja": "何かあったら声をかけてくださいね。",
    "english": "Please let me know if you need anything."
   }
  },
  {
   "id": "c-deai-ga-aru",
   "romaji": "deai ga aru",
   "polite": "deai ga arimasu",
   "english": "meet someone new",
   "ja": "出会いがある",
   "kana": "であいがある",
   "politeJa": "出会いがあります",
   "noun": "deai",
   "particle": "ga",
   "verb": "aru",
   "verbJa": "ある",
   "verbSense": "there is; have (events, chances)",
   "englishVerb": "meet",
   "trap": "English 'I never meet anyone' leads to dare ni mo awanai, which sounds like you never see people at all. Meeting someone new is talked about as a deai (an encounter): deai ga nai.",
   "partners": [
    "chansu (a chance)",
    "kikkake (an opening)",
    "en (a connection, fate)"
   ],
   "flags": [],
   "use": "Mostly in the negative, the stock complaint deai ga nai (I never meet anyone), and in good wishes: ii deai ga arimasu you ni (hope you meet someone great). Often about romance, but it also covers new friends at a new job or school.",
   "notes": "deau is the verb, for meeting for the first time or by chance: daigaku de deatta (we met at uni).",
   "example": {
    "romaji": "shokuba ni zenzen deai nai n da yo.",
    "ja": "職場に全然出会いないんだよ。",
    "english": "I never meet anyone at work."
   },
   "examplePolite": {
    "romaji": "shokuba ni wa zenzen deai ga nai n desu yo.",
    "ja": "職場には全然出会いがないんですよ。",
    "english": "I never get to meet anyone at work."
   }
  }
 ],
