   "english": "go out for drinks",
   "ja": "飲みに行く",
   "kana": "のみにいく",
   "politeJa": "飲みに行きます",
   "noun": "nomi",
   "particle": "ni",
   "verb": "iku",
   "verbJa": "行く",
   "verbSense": "go; with a verb stem or activity noun + ni, go (out) to do it (tabe ni iku, kaimono ni iku)",
   "englishVerb": "go out",
   "trap": null,
   "partners": [
    "kaimono (shopping)",
