 "chunkId": "body-8",
 "label": "Rest and recovery",
 "topic": "Body & health",
 "rationale": "Lying down and getting better: the fever drops, the cold clears up, the tiredness goes.",
 "mixUps": "sagaru, naoru and toreru say the thing goes away by itself, so they take ga; their o twins mean someone does it (netsu o sageru, kaze o naosu). yoko ni naru is lying down to rest, not neru (sleep).",
 "targets": [
  {
   "id": "c-yoko-ni-naru",
   "romaji": "yoko ni naru",
   "polite": "yoko ni narimasu",
   "english": "lie down",
   "ja": "横になる",
   "kana": "よこになる",
   "politeJa": "横になります",
   "noun": "yoko",
   "particle": "ni",
   "verb": "naru",
   "verbJa": "なる",
   "verbSense": "become, turn into; with yoko (side) it's 'become horizontal'",
   "englishVerb": "lie",
   "trap": "Dictionaries give yokotawaru, which sounds written; in speech you 'become sideways', yoko ni naru. Neru also works but suggests going to sleep.",
   "partners": [
    "aomuke (on your back)",
    "utsubuse (face down)"
   ],
   "flags": [],
   "use": "For lying down to rest rather than to sleep: chotto yoko ni naru (I'll lie down a bit); to someone unwell, yoko ni natta hou ga ii yo. The ni always stays: never yoko naru.",
   "notes": "Related single verb: nekorobu (lie down casually, sprawl).",
   "example": {
    "romaji": "chotto yoko ni natte ii?",
    "ja": "ちょっと横になっていい？",
    "english": "Mind if I lie down for a bit?"
   },
   "examplePolite": {
    "romaji": "chotto yoko ni natte mo ii desu ka?",
    "ja": "ちょっと横になってもいいですか？",
    "english": "Would it be all right if I lie down for a bit?"
   }
  },
  {
   "id": "c-netsu-ga-sagaru",
   "romaji": "netsu ga sagaru",
   "polite": "netsu ga sagarimasu",
   "english": "fever goes down",
   "ja": "熱が下がる",
   "kana": "ねつがさがる",
   "politeJa": "熱が下がります",
   "noun": "netsu",
   "particle": "ga",
   "verb": "sagaru",
   "verbJa": "下がる",
   "verbSense": "go down, drop (temperature, prices); also step back",
   "englishVerb": "go down",
   "trap": "Not netsu ga oriru or heru: a fever 'drops', netsu ga sagaru (netsu sagatta?).",
   "partners": [
    "kion (air temperature)",
    "nedan (price)",
    "seiseki (grades)"
   ],
   "flags": [],
   "use": "The follow-up to any fever: netsu sagatta? answered with sagatta or mada sagaranai. Ga often drops; a fever going up is netsu ga agaru.",
   "notes": "Bringing a fever down is netsu o sageru; the medicine for it is genetsuzai. Netsu ga hiku (the fever subsides) is also fine.",
   "example": {
    "romaji": "kusuri nondara, netsu sagatta.",
    "ja": "薬飲んだら、熱下がった。",
    "english": "I took some medicine and my fever went down."
   },
   "examplePolite": {
    "romaji": "kusuri o nondara, netsu ga sagarimashita.",
    "ja": "薬を飲んだら、熱が下がりました。",
    "english": "After I took the medicine, my fever came down."
   }
  },
  {
   "id": "c-kaze-ga-naoru",
   "romaji": "kaze ga naoru",
   "polite": "kaze ga naorimasu",
   "english": "get over a cold",
   "ja": "風邪が治る",
   "kana": "かぜがなおる",
