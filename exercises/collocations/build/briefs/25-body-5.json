  },
  {
   "id": "c-taichou-o-kuzusu",
   "romaji": "taichou o kuzusu",
   "polite": "taichou o kuzushimasu",
   "english": "get run down, fall ill",
   "ja": "体調を崩す",
   "kana": "たいちょうをくずす",
   "politeJa": "体調を崩します",
   "noun": "taichou",
   "particle": "o",
   "verb": "kuzusu",
   "verbJa": "崩す",
   "verbSense": "knock down, break up (a wall, a pose); upset, throw off (balance, health, pace); also break a note into change",
   "englishVerb": "get",
   "trap": "Byouki ni naru isn't wrong but sounds like a proper illness; for a passing bug or being run down, people say taichou (o) kuzushita.",
   "partners": [
    "baransu (balance: lose your balance)",
