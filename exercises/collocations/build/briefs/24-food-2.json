   "noun": "gohan",
   "particle": "o",
   "verb": "tsukuru",
   "verbJa": "作る",
   "verbSense": "make; with food, prepare or cook",
   "englishVerb": "cook",
   "trap": null,
   "partners": [
    "bangohan (dinner)",
