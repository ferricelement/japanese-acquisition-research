---
import JaText from './JaText.astro';
import { FLAG_LABEL } from '../lib/data';
import { WORDLISTS, type ListKey, type Word } from '../lib/wordlists';

// One entry of the core, sets or phrases list: meaning, how it's used, examples; spelling, frequency and links last.
interface Props { item: Word; list: ListKey }
const { item, list } = Astro.props;
const course = WORDLISTS[list].course;
const mates = course.mates(item);
const links = course.listLinksOf(item);
const examples = [['casual', item.example], ['polite', item.examplePolite]] as const;
const ROLE: Record<string, string> = { say: 'you say it', hear: 'said to you', both: 'you say it and hear it' };
---

<section class="vl-item vl-idiom not-content">
	<h2 id={item.id} class="vl-ro" translate="no">{item.romaji}</h2>
	<button type="button" class="vl-play" data-say={item.ja} aria-label={`Play ${item.romaji}`} data-pagefind-ignore>Play</button>
	<span class="vl-meta">{item.flags.map((f) => <span class="vl-flag">{FLAG_LABEL[f] ?? f}</span>)}</span>
	{item.polite && (
		<p class="vl-po">
			<span class="vl-tag">polite</span> <span translate="no">{item.polite}</span>
			{item.politeJa && <button type="button" class="vl-play" data-say={item.politeJa} aria-label={`Play ${item.polite}`} data-pagefind-ignore>Play</button>}
		</p>
	)}
	<p class="vl-en vl-word-en">{item.english}</p>
	{(item.use || item.notes) && (
		<div class="vl-use">
			{item.use && <p><JaText text={item.use} /></p>}
			{item.notes && <p class="vl-use-note"><JaText text={item.notes} /></p>}
		</div>
	)}
	<div class="vl-examples">
		{examples.map(([label, ex]) => ex && (
			<div class="vl-ex">
				<div class="vl-ex-top">
					<span class="vl-tag">{label}</span>
					<button type="button" class="vl-play" data-say={ex.ja} aria-label={`Play ${label} example`} data-pagefind-ignore>Play</button>
				</div>
				<p class="vl-ex-ro" translate="no">{ex.romaji}</p>
				<p class="vl-ex-en">{ex.english}</p>
				<p class="vl-ex-ja" lang="ja">{ex.ja}</p>
			</div>
		))}
	</div>
	<p class="vl-refs">
		<span><b>Written</b> <span lang="ja">{item.ja}</span>{item.kana && item.kana !== item.ja && <> · <span lang="ja">{item.kana}</span></>}{item.politeJa && <> · <span lang="ja">{item.politeJa}</span></>}</span>
		{item.role && <span><b>Who</b> {ROLE[item.role]}</span>}
		{item.count !== undefined ? (
			<span><b>Heard</b> {item.count ? `${item.count}× in 3.17 million lines of film and TV subtitles` : 'too rare in film subtitles to count'}</span>
		) : (
			<span><b>Rank</b> {item.freqRank != null ? `#${item.freqRank} in 3,030 TV dramas` : 'not in the drama list; chosen on judgement'}</span>
		)}
		{mates.length > 0 && (
			<span><b>Learn alongside</b> {mates.map(({ m, later }, i) => (
				<>{i > 0 && ', '}<a href={course.itemUrl(m.id)} translate="no">{m.romaji}</a>{later > 0 && <span class="vl-later"> (Stage {later})</span>}</>
			))}</span>
		)}
		{links.length > 0 && (
			<span><b>Main list</b> {links.map((l, i) => (
				<>{i > 0 && ', '}<a href={l.href} translate="no">{l.romaji}</a><span class="vl-later"> (Stage {l.stage})</span></>
			))}</span>
		)}
	</p>
</section>
