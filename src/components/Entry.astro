---
import { FLAG_LABEL, anchorFor, groupMates, itemById, itemUrl, type Item } from '../lib/data';

interface Props { item: Item }
const { item } = Astro.props;

// Only flag ranks the tokenizer made unreliable; most freqNotes just restate the lookup.
const caveat = !!item.freqNote && /tokeni[sz]|split|undercount|judg|no usable|component|rank of/i.test(item.freqNote);
const rank = item.freqRank != null ? `#${item.freqRank}${caveat ? '*' : ''}` : '—';
const rankTitle = item.freqRank != null
	? `Rank ${item.freqRank} in 3,030 TV dramas${item.freqNote ? ` (${item.freqNote})` : ''}`
	: (item.freqNote ?? 'No usable rank');
const mates = groupMates(item);
const prereqs = item.prereqs.map((p) => itemById(p)?.item).filter((x): x is Item => !!x);
---

<details class="vl-entry" id={anchorFor(item)}>
	<summary>
		<span class="vl-main">
			<span class="vl-ro">{item.romaji}</span>
			{item.polite && <span class="vl-po"><span class="vl-tag">polite</span>{item.polite}</span>}
		</span>
		<span class="vl-en">{item.english}</span>
		<span class="vl-meta">
			{item.flags.map((f) => <span class="vl-flag">{FLAG_LABEL[f] ?? f}</span>)}
			<span class="vl-rank" title={rankTitle}>{rank}</span>
		</span>
	</summary>
	<div class="vl-body">
		<p class="vl-jaline">
			<span class="vl-ja" lang="ja">{item.ja}{item.kana && item.kana !== item.ja && <span class="vl-kana">{item.kana}</span>}</span>
			{item.politeJa && <span class="vl-ja" lang="ja">{item.politeJa}</span>}
			<button type="button" class="vl-play" data-say={item.ja}>Play</button>
		</p>
		<p class="vl-use">{item.use}</p>
		<div class="vl-examples">
			{[['casual', item.example], ['polite', item.examplePolite]].map(([label, ex]) => ex && typeof ex === 'object' && (
				<div class="vl-ex">
					<div class="vl-ex-top">
						<span class="vl-tag">{label}</span>
						<button type="button" class="vl-play" data-say={ex.ja}>Play</button>
					</div>
					<p class="vl-ex-ro">{ex.romaji}</p>
					<p class="vl-ex-en">{ex.english}</p>
					<p class="vl-ex-ja" lang="ja">{ex.ja}</p>
				</div>
			))}
		</div>
		{item.notes && <p class="vl-note">{item.notes}</p>}
		{(mates.length > 0 || prereqs.length > 0 || item.alsoIn.length > 0) && (
			<p class="vl-refs">
				{mates.length > 0 && (
					<span><b>Learn alongside:</b> {mates.map((m, i) => <>{i > 0 && ', '}<a href={itemUrl(m.id)}>{m.romaji}</a></>)}</span>
				)}
				{prereqs.length > 0 && (
					<span><b>Learn first:</b> {prereqs.map((m, i) => <>{i > 0 && ', '}<a href={itemUrl(m.id)}>{m.romaji}</a></>)}</span>
				)}
				{item.alsoIn.length > 0 && <span><b>Also in:</b> {item.alsoIn.join(' · ')}</span>}
			</p>
		)}
	</div>
</details>
