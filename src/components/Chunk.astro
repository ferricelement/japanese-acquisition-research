---
import Entry from './Entry.astro';
import { categoryByName, chunkAnchor, url, type Block } from '../lib/data';

interface Props { block: Block; show: 'category' | 'stage' }
const { block, show } = Astro.props;
const cat = categoryByName(block.category);
const mixups = block.interference && !/^none\.?$/i.test(block.interference.trim()) ? block.interference : null;
---

<section class="vl-chunk">
	<h2 id={chunkAnchor(block)}>{block.label}</h2>
	<p class="vl-chunk-meta not-content">
		{show === 'category'
			? <a class="vl-chip" href={url(`categories/${cat.slug}/`)}>{cat.name}</a>
			: <a class="vl-chip" href={url(`stages/${block.stage}/#${chunkAnchor(block)}`)}>Stage {block.stage}</a>}
		<span class="vl-range">{block.range.replace('-', '–')}</span>
	</p>
	{block.rationale && <p class="vl-chunk-note">{block.rationale}</p>}
	{mixups && <p class="vl-chunk-note"><b>Mix-ups:</b> {mixups}</p>}
	<div class="vl-entries not-content">
		{block.items.map((item) => <Entry item={item} />)}
	</div>
</section>
