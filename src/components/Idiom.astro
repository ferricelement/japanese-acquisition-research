---
import JaText from './JaText.astro';
import { FLAG_LABEL } from '../lib/data';
import { idiomCourse, type Idiom } from '../lib/idioms';

interface Props { item: Idiom }
const { item } = Astro.props;

const mates = idiomCourse.mates(item);
const links = idiomCourse.listLinksOf(item);
const examples = [['casual', item.example], ['polite', item.examplePolite]] as const;
const m = item.measured;
const heardTitle = m
	? `Said ${m.count} times in 3.17 million lines of film and TV subtitles (${m.perMillion} per million lines)`
	: 'Too rare in the subtitle corpus to count';
---

<section class="vl-item not-content">
	<h2 id={item.id} class="vl-ro" translate="no">{item.romaji}</h2>
	{item.polite && <span class="vl-po" translate="no"><span class="vl-tag">polite</span> {item.polite}</span>}
	<span class="vl-meta">
		{item.flags.map((f) => <span class="vl-flag">{FLAG_LABEL[f] ?? f}</span>)}
		<span class="vl-rank" title={heardTitle}><span class="sr-only">heard </span>{m ? `${m.count}×` : <><span aria-hidden="true">—</span><span class="sr-only">rarely</span></>}</span>
	</span>
	<p class="vl-en">{item.english}</p>
	<p class="vl-jaline">
		<span class="vl-ja" lang="ja">{item.ja}</span>
		{item.kana && item.kana !== item.ja && <> <span class="vl-ja vl-kana" lang="ja">{item.kana}</span></>}
		<button type="button" class="vl-play" data-say={item.ja} aria-label={`Play ${item.romaji}`} data-pagefind-ignore>Play</button>
		{item.politeJa && <> <span class="vl-ja" lang="ja">{item.politeJa}</span>
			<button type="button" class="vl-play" data-say={item.politeJa} aria-label={`Play ${item.polite}`} data-pagefind-ignore>Play</button></>}
	</p>
	<p class="vl-parts">
		<span class="vl-tag">literally</span> <span class="vl-sense"><JaText text={`“${item.literal}”`} /></span>
		{item.englishIdiom && <><span class="vl-tag">English</span> <span>{item.englishIdiom}</span></>}
	</p>
	<p class="vl-use"><JaText text={item.use} /></p>
	<div class="vl-examples">
		{examples.map(([label, ex]) => ex && (
			<div class="vl-ex">
				<div class="vl-ex-top">
					<span class="vl-tag">{label}</span>
					<button type="button" class="vl-play" data-say={ex.ja} aria-label={`Play ${label} example`} data-pagefind-ignore>Play</button>
				</div>
				<p class="vl-ex-ro" translate="no">{ex.romaji}</p>
				<p class="vl-ex-en">{ex.english}</p>
				<p class="vl-ex-ja" lang="ja">{ex.ja}</p>
			</div>
		))}
	</div>
	{item.notes && <p class="vl-note"><JaText text={item.notes} /></p>}
	{(mates.length > 0 || links.length > 0) && (
		<p class="vl-refs">
			{mates.length > 0 && (
				<span><b>Learn alongside:</b> {mates.map(({ m, later }, i) => (
					<>{i > 0 && ', '}<a href={idiomCourse.itemUrl(m.id)} translate="no">{m.romaji}</a>{later > 0 && <span class="vl-later"> (Stage {later})</span>}</>
				))}</span>
			)}
			{links.length > 0 && (
				<span><b>Main list:</b> {links.map((l, i) => (
					<>{i > 0 && ', '}<a href={l.href} translate="no">{l.romaji}</a><span class="vl-later"> (Stage {l.stage})</span></>
				))}</span>
			)}
		</p>
	)}
</section>
