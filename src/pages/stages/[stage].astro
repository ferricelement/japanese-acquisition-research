---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import Chunk from '../../components/Chunk.astro';
import EntryScripts from '../../components/EntryScripts.astro';
import { blockById, chunkAnchor, data } from '../../lib/data';

export function getStaticPaths() {
	return data.stages.map((_, i) => ({ params: { stage: String(i + 1) }, props: { index: i } }));
}

const stage = data.stages[Astro.props.index];
const blocks = stage.chunkIds.map(blockById);
const headings = blocks.map((b) => ({ depth: 2, slug: chunkAnchor(b), text: b.label }));
---

<StarlightPage frontmatter={{ title: stage.name, description: stage.summary }} headings={headings}>
	<p class="vl-lead">{stage.summary}</p>
	<p class="vl-count">{stage.items} items in {blocks.length} chunks. Tap an item for its meaning and casual and polite examples.</p>
	{blocks.map((b) => <Chunk block={b} show="category" />)}
	<EntryScripts />
</StarlightPage>
