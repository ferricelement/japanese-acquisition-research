---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import Chunk from '../../components/Chunk.astro';
import EntryScripts from '../../components/EntryScripts.astro';
import { categories, chunkAnchor, data } from '../../lib/data';

export function getStaticPaths() {
	return categories.map((c) => ({ params: { cat: c.slug }, props: { key: c.key } }));
}

const cat = categories.find((c) => c.key === Astro.props.key)!;
// data.blocks is in course order, so this keeps stage order within the category.
const blocks = data.blocks.filter((b) => b.category === cat.name);
const headings = blocks.map((b) => ({ depth: 2, slug: chunkAnchor(b), text: b.label }));
const scope = cat.scope.charAt(0).toUpperCase() + cat.scope.slice(1);
---

<StarlightPage frontmatter={{ title: cat.name, description: `${scope}.` }} headings={headings}>
	<p class="vl-lead">{scope}.</p>
	<p class="vl-count">{cat.items} items in {blocks.length} chunks, in course order.</p>
	{blocks.map((b) => <Chunk block={b} show="stage" />)}
	<EntryScripts />
</StarlightPage>
